{
  "name": "comphp/logging-monolog",
  "type": "library",
  "description": "Logging Driver for CommonPHP which wraps the Monolog library for Runtime compliance",
  "license": "MIT",
  "version": "0.3",
  "autoload": {
    "psr-4": {
      "CommonPHP\\Drivers\\Logging\\Monolog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CommonPHP\\Drivers\\Logging\\Monolog\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.5",
    "comphp/logging": "^0.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.1",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}